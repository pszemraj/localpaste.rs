%YAML 1.2
---
name: LocalPaste Markdown
file_extensions: [md, markdown]
scope: text.html.markdown.localpaste
contexts:
  main:
    # Four spaces or a tab starts literal indented code, including fence-looking
    # text. It ends on dedent, rather than waiting for a closing fence.
    - match: '^(?: {4}| {0,3}\t)'
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^(?!(?: {4}| {0,3}\t)|[ \t]*\r?$)'
          pop: true
    # Ordinary prose cannot open a block. Avoid testing every generated list
    # fence prefix on these common paragraph starts.
    - match: '^(?= {0,3}\p{L})'
      push: paragraph
    - include: blocks
    - match: '(?=\S)'
      push: paragraph
  paragraph:
    # Indented code cannot interrupt a paragraph. Keep its continuation in the
    # inline context until a blank line or an actual block opening occurs,
    # including the next link or footnote definition in a chain.
    - match: '^(?=[ \t]*\r?$| {0,3}(?:#{1,6}(?:[ \t]+|\r?$)|`{3,}[^`\n]*$|~{3,}|(?:={3,}|-{3,})[ \t]*\r?$|>|[-+*][ \t]+|1[.)][ \t]+|\[\^?[^\]\n]+\]:))'
      pop: true
    - include: inline
  markup:
    - include: blocks
    - include: inline
  blocks:
    # Top-level fences have at most three spaces before a closing delimiter.
    # Indented or container-prefixed fence-looking lines remain literal code.
    - match: '^ {0,3}(`{3,})[^`\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^ {0,3}\1`*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    - match: '^ {0,3}(~{3,})[^\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^ {0,3}\1~*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    # List contexts retain their item indentation, including when a fence opens
    # directly after the marker. A quoted fence ends at the next unquoted line.
    - match: '^[ \t]*(>)[ \t]*(`{3,})[^`\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^(?![ \t]*\1)'
          pop: true
        - match: '^[ \t]*\1[ \t]*\2`*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    - match: '^[ \t]*(>)[ \t]*(~{3,})[^\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^(?![ \t]*\1)'
          pop: true
        - match: '^[ \t]*\1[ \t]*\2~*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    # A definition marker ends at the colon. Its body remains normal prose.
    - match: '^ {0,3}\[\^[^\]\n]+\]:'
      scope: constant.other.reference.link.markdown.localpaste
    - match: '^ {0,3}#{1,6}[ \t]+.*$'
      scope: markup.heading.markdown
    - match: '^ {0,3}(?:={3,}|-{3,})[ \t]*\r?$'
      scope: markup.heading.markdown
    - include: list-items
    - match: '^ {0,3}>[ \t]?'
      scope: punctuation.definition.blockquote.markdown
    - match: '^\s*(?:[-+*]|\d+[.)])[ \t]+'
      scope: punctuation.definition.list.markdown
    - match: '^ {0,3}\[[^\]\n]+\]:[ \t]*\S+'
      scope: markup.underline.link.markdown
  inline:
    # Consume escaped punctuation before it can open inline markup. Code
    # contexts deliberately do not include this rule: backslashes are literal.
    - match: '\\[[:punct:]]'
    - match: '\[\^[^\]\n]+\]'
      scope: constant.other.reference.link.markdown.localpaste
    - match: '(`+)(?!`)'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.inline.markdown.localpaste
        # An inline span can cross a content line, but never a paragraph boundary.
        - match: '^(?=(?: {0,3}>[ \t]?)*[ \t]*\r?\n)'
          pop: true
        # Block structure interrupts a paragraph before inline-code parsing.
        - match: '^(?=(?: {0,3}>[ \t]?)* {0,3}(?:#{1,6}(?:[ \t]+|\r?$)|`{3,}[^`\n]*$|~{3,}|(?:={3,}|-{3,})[ \t]*\r?$))'
          pop: true
        # Tight lists have no blank paragraph separator between their items.
        # A new marker ends the prior item's span; indented continuation stays.
        - match: '^(?=(?: {0,3}>[ \t]?)*[ \t]*(?:[-+*]|\d+[.)])[ \t]+)'
          pop: true
        - match: '(?<!`)\1(?!`)'
          pop: true
    - match: '\*\*[^*\n]+\*\*|__[^_\n]+__'
      scope: markup.bold.markdown
    - match: '\*[^*\n]+\*|(?<![\p{L}\p{N}_])_[^_\n]+_(?![\p{L}\p{N}_])'
      scope: markup.italic.markdown
    - match: '!?\[[^\]\n]*\]\([^\)\n]*\)'
      scope: markup.underline.link.markdown
