%YAML 1.2
---
name: LocalPaste Markdown
file_extensions: [md, markdown]
scope: text.html.markdown.localpaste
contexts:
  main:
    # Consume escaped punctuation before it can open inline markup. Code
    # contexts deliberately do not include this rule: backslashes are literal.
    - match: '\\[[:punct:]]'
    # Capture the opening delimiter so shorter or different fences cannot close it.
    - match: '^[ \t]*(?:>[ \t]*)?(?:(?:[-+*]|\d+[.)])[ \t]+)?(`{3,})[^`\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^[ \t]*(?:>[ \t]*)?(?:(?:[-+*]|\d+[.)])[ \t]+)?\1`*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    - match: '^[ \t]*(?:>[ \t]*)?(?:(?:[-+*]|\d+[.)])[ \t]+)?(~{3,})[^\n]*$'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.block.markdown.localpaste
        - match: '^[ \t]*(?:>[ \t]*)?(?:(?:[-+*]|\d+[.)])[ \t]+)?\1~*[ \t]*\r?$'
          scope: punctuation.definition.raw.markdown.localpaste
          pop: true
    # A definition marker ends at the colon. Its body remains normal prose.
    - match: '^ {0,3}\[\^[^\]\n]+\]:'
      scope: constant.other.reference.link.markdown.localpaste
    - match: '\[\^[^\]\n]+\]'
      scope: constant.other.reference.link.markdown.localpaste
    - match: '^ {0,3}#{1,6}[ \t]+.*$'
      scope: markup.heading.markdown
    - match: '^ {0,3}(?:={3,}|-{3,})[ \t]*$'
      scope: markup.heading.markdown
    - match: '^ {0,3}>[ \t]?'
      scope: punctuation.definition.blockquote.markdown
    - match: '^\s*(?:[-+*]|\d+[.)])[ \t]+'
      scope: punctuation.definition.list.markdown
    - match: '(`+)(?!`)'
      scope: punctuation.definition.raw.markdown.localpaste
      push:
        - meta_scope: markup.raw.inline.markdown.localpaste
        # An inline span can cross a content line, but never a paragraph boundary.
        - match: '^[ \t]*\r?\n'
          pop: true
        - match: '(?<!`)\1(?!`)'
          pop: true
    - match: '\*\*[^*\n]+\*\*|__[^_\n]+__'
      scope: markup.bold.markdown
    - match: '\*[^*\n]+\*|(?<![\p{L}\p{N}_])_[^_\n]+_(?![\p{L}\p{N}_])'
      scope: markup.italic.markdown
    - match: '!?\[[^\]\n]*\]\([^\)\n]*\)'
      scope: markup.underline.link.markdown
    - match: '^ {0,3}\[[^\]\n]+\]:[ \t]*\S+'
      scope: markup.underline.link.markdown
